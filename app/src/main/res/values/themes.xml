<resources>
    <color name="splash_background">#F5EDE2</color>
    <color name="kenzo_terracotta">#B85E3C</color>
    <color name="kenzo_dialog_surface">#FFFAF3</color>
    <color name="kenzo_dialog_text">#282522</color>

    <style name="Theme.KunlikVazifalar" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/kenzo_terracotta</item>
        <item name="android:colorPrimary">@color/kenzo_terracotta</item>
        <item name="android:timePickerDialogTheme">@style/Theme.Kenzo.TimePicker</item>
    </style>

    <style name="Theme.Kenzo.TimePicker" parent="android:Theme.Material.Light.Dialog">
        <item name="android:colorAccent">@color/kenzo_terracotta</item>
        <item name="android:colorPrimary">@color/kenzo_terracotta</item>
        <item name="android:textColorPrimary">@color/kenzo_dialog_text</item>
        <item name="android:windowBackground">@color/kenzo_dialog_surface</item>
        <item name="android:textColorHighlight">#F0DDD4</item>
    </style>

    <style name="Theme.Kenzo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_kenzo_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.KunlikVazifalar</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
